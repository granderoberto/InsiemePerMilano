# Copia in .env (sviluppo) o imposta come variabili d'ambiente sull'hosting. MAI committare i valori veri.

# --- database (MySQL 8) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
# Sull'hosting: testo del certificato CA del database (i ritorni a capo come \n); in sviluppo basta certs/ca.pem
DB_CA_PEM=

# --- sito ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=            # lunga e casuale; se cambia, la 2FA degli utenti va azzerata
DJANGO_ALLOWED_HOSTS=lanostracitta.example
DJANGO_CSRF_ORIGINS=https://lanostracitta.example
SITE_URL=https://lanostracitta.example     # usato nei link delle email
DATA_DIR=/data                               # disco persistente per media e archivio temporaneo

# --- email (Gmail con password per le app, oppure un altro provider: vedi docs/produzione.md) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_TLS=1
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=La Nostra Città <noreply@lanostracitta.example>

# --- Gmail API (HTTPS): per Render gratuito, che blocca l'SMTP. Ha la precedenza sull'SMTP; vedi docs/produzione.md ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Verifica del documento: auto (controlli veri se Tesseract e i modelli ci sono), reale, simulato ---
IA_DOCUMENTO=auto

# --- IA con OpenRouter (modelli gratuiti, 50 richieste al giorno: docs/piano_ia_openrouter.md). Chiave da https://openrouter.ai/keys ---
OPENROUTER_API_KEY=
# Modelli in ordine di preferenza, separati da virgola (facoltativi: vedi docs/ia_sonda_modelli.md)
IA_MODELLI_TESTO=recursive/flint-v1.0:free
IA_MODELLI_VISIONE=dots-studio/dots-3-note-preview:free
# sincrona = controlli simulati subito (predefinito); coda = prefiltro locale + modello in background (serve OPENROUTER_API_KEY)
IA_MODALITA=sincrona
# 1 = il lavoratore della coda gira dentro il sito (con IA_MODALITA=coda)
IA_LAVORATORE=0

# --- SPID/CIE (solo dopo l'adesione: vedi docs/spid_produzione.md) ---
SPID_SERVIZIO_URL=
SPID_BRIDGE_SECRET=
SPID_AMBIENTE_PROVA=1
